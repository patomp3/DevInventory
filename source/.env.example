# คัดลอกเป็น .env แล้วแก้ค่า — ห้าม commit ไฟล์ .env

# ชื่อโดเมนจริงที่เข้าเว็บ (ใช้กับ Caddy และ redirect URI ของ Google ในเฟส 2 — ดู design.md §15.1/§19.2)
APP_DOMAIN=inventory.example.com
APP_BASE_URL=https://inventory.example.com

# ฐานข้อมูล
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory
DATABASE_URL=postgres://inventory:change-me@db:5432/inventory

# secret สำหรับ session (ยาว ≥ 32 ตัวอักษร สร้างด้วย: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-32chars

# Super Admin คนแรก (บัญชีเดียวที่เกิดได้โดยไม่ผ่านคำเชิญ) ต้องเปลี่ยนรหัสผ่านตอน login ครั้งแรก
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me-now-please

# ที่เก็บไฟล์แนบ
FILES_DIR=/data/files   # dev บน Windows ใช้ ./data/files

# เฟส 2 (Google login) — ไม่ต้องตั้งในเฟส 1
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
